{
  "name": "bigbullsglobal-android",
  "version": "1.0.0",
  "private": true,
  "description": "BigbullsGlobal Android trading terminal wrapper",
  "scripts": {
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "cap sync android && cd android && ./gradlew bundleRelease",
    "assets": "node generate-assets.mjs",
    "build:web": "esbuild www/app.js --bundle --platform=browser --target=es2020 --outfile=www/app.bundle.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capgo/capacitor-native-biometric": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@capacitor/assets": "^3.0.5",
    "sharp": "^0.34.3",
    "esbuild": "^0.25.11"
  }
}